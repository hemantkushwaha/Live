# Environment Variables Example for LiveConnect
PORT=3000
CLIENT_URL=http://localhost:3000
JWT_SECRET=liveconnect-default-jwt-secret-key-2026
JWT_REFRESH_SECRET=liveconnect-default-jwt-refresh-secret-key-2026
DATABASE_URL=postgresql://localhost:5432/liveconnect
API_BASE_URL=http://localhost:3000/api/v1
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:global.turn.twilio.com:3478

# Platform runtime defaults
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
REDIS_URL="redis://localhost:6379"

# Object Storage Configuration
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME="liveconnect_cdn"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# LiveKit SFU Configuration
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretkey
